# Normalize text files and enforce native line endings per file type
* text=auto

# Windows PowerShell & Batch scripts always use CRLF
*.ps1 text eol=crlf
*.bat text eol=crlf

# Web, YAML & Markdown files use LF in index
*.yml text eol=lf
*.yaml text eol=lf
*.html text eol=lf
*.js text eol=lf
*.md text eol=lf
